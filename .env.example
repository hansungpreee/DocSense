# 이 파일을 .env로 복사한 뒤 값을 채운다:  cp .env.example .env   (Windows: copy .env.example .env)
# .env는 .gitignore에 들어 있어 커밋되지 않는다. API 키를 카톡·노션·이슈에 붙여 넣지 않는다.

# Alibaba Cloud Model Studio(싱가포르 리전)에서 발급한 API 키
VLM_API_KEY=
VLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 날짜가 붙은 스냅샷으로 고정한다. 날짜 없는 qwen3-vl-plus는 제공처가 새 버전으로 바꾸면 결과가 달라진다
# 바꾸면 기준선(v1·v2)을 그 모델로 다시 잰다
VLM_MODEL=qwen3.7-plus-2026-05-26

# Gemini (데모·업로드 검사 서버가 Qwen과 동시에 부르는 교차 확인 모델). Google AI Studio 키, OpenAI 호환 주소
# 비워 두면 Gemini를 부르지 않고 모든 결과가 「미확정(담당자 확인)」이 된다. 확정 규칙: Gemini 확신도 > 0.95 이고 두 모델 코드 일치
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# 이 값 미만이면 「기타」(NEW-xx)로 가분류
CONFIDENCE_THRESHOLD=0.7

# 데모 설정: DEMO_MOCK=0이면 실제 API 호출, 1이면 가짜 결과(MOCK)
PROMPT_VERSION=v1
DEMO_MOCK=1
# 호출 사이 최소 간격(초)
VLM_MIN_INTERVAL=1.0

# (선택) 엔진 호출 로그 파일. 비워 두면 logs/engine.log. 호출 1건당 한 줄
# (시각·파일명·상태·재시도 횟수·오류·모델·프롬프트 버전만, 문서 내용·API 키는 남기지 않음)
# ENGINE_LOG_PATH=logs/engine.log

# (선택) 데모와 엔진이 읽을 분류 체계 파일. 비워 두면 config/taxonomy.yaml을 바로 읽는다.
# 다른 분류 체계 초안으로 시험할 때만 지정한다. 예: TAXONOMY_PATH=config/taxonomy_plan75_hcl_draft.yaml
# TAXONOMY_PATH=
